        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'order_number' => [
        'description' => 'Numer zamówienia.',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'project_id' => [
        'description' => 'ID zamówionego projektu.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'project_title' => [
        'description' => 'Nazwa projektu w momencie zamówienia.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'variant' => [
        'description' => 'Wariant: digital (PDF) lub print (4 egzemplarze).',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'print',
      ],
      'amount' => [
        'description' => 'Kwota zamówienia w PLN.',
        'type' => 'numeric',
        'precision' => 10,
        'scale' => 2,
        'not null' => TRUE,
        'default' => 0.00,
      ],
      'currency' => [
        'description' => 'Waluta.',
        'type' => 'varchar',
