      'invoice_nip' => [
        'description' => 'NIP do faktury (opcjonalnie).',
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
        'default' => '',
      ],
      'notes' => [
        'description' => 'Uwagi do zamówienia i prośby o zgody na zmiany.',
        'type' => 'text',
        'not null' => FALSE,
      ],
      'payment_method' => [
        'description' => 'Wybrana metoda płatności (blik_p24, blik_payu, blik_autopay).',
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'default' => 'blik_p24',
      ],
      'payment_status' => [
        'description' => 'Status płatności (pending, paid, failed).',
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'default' => 'pending',
      ],
      'transaction_id' => [
        'description' => 'Identyfikator transakcji w bramce płatności.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'default' => '',
      ],
      'created' => [
        'description' => 'Timestamp złożenia zamówienia.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'uq_order_number' => ['order_number'],
    ],
