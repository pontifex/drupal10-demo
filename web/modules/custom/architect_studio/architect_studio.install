      ],
      'transaction_id' => [
        'description' => 'Identyfikator transakcji w bramce płatności.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
        'default' => '',
      ],
      'created' => [
        'description' => 'Timestamp złożenia zamówienia.',
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
