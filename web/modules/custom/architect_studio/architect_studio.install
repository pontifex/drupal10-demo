        'length' => 64,
        'not null' => TRUE,
        'default' => 'brak',
      ],
      'heating_type' => [
        'description' => 'Zalecane źródło ciepła.',
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'default' => 'Pompa ciepła + podłogówka',
      ],
      'price_digital' => [
