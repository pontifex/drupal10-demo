        'precision' => 5,
        'scale' => 2,
        'not null' => TRUE,
        'default' => 7.5,
      ],
      'min_lot_width' => [
        'description' => 'Minimalna szerokość działki w metrach.',
        'type' => 'numeric',
        'precision' => 5,
        'scale' => 2,
        'not null' => TRUE,
        'default' => 18.0,
      ],
      'min_lot_length' => [
