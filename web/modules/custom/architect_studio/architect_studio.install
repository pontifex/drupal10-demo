/**
 * Implements hook_install().
 */
function architect_studio_install(): void {
  $database = Database::getConnection();
  $time = \Drupal::time()->getRequestTime();

  // Dodanie wstępnych projektów autorskich.
  $projects = [
    [
      'code' => 'MOD-125',
      'title' => 'Dom Parterowy Moderno 125',
      'category' => 'dom_parterowy',
      'usable_area' => 125.40,
      'building_area' => 158.20,
      'roof_angle' => 30.0,
      'building_height' => 6.85,
      'min_lot_width' => 21.40,
      'min_lot_length' => 24.50,
      'rooms_count' => 4,
      'bathrooms_count' => 2,
      'garage' => '1-stanowiskowy w bryle',
      'heating_type' => 'Pompa ciepła powietrze-woda + ogrzewanie podłogowe',
      'price_digital' => 3350.00,
      'price_print' => 3950.00,
      'is_hidden' => 0,
      'description' => 'Nowoczesny, energooszczędny dom parterowy z dużymi przeszkleniami od strony ogrodu. Wyraźny podział na strefę dzienną (otwarty salon z jadalnią i kuchnią ze spiżarnią) oraz prywatną strefę nocną z 3 sypialniami.',
      'image_url' => '/modules/custom/architect_studio/images/moderno125.svg',
      'floor_plan_url' => '/modules/custom/architect_studio/images/plan_moderno125.svg',
      'created' => $time,
      'updated' => $time,
    ],
    [
      'code' => 'POD-148',
      'title' => 'Dębowa Polana – Dom z Poddaszem 148',
      'category' => 'dom_z_poddaszem',
      'usable_area' => 148.60,
      'building_area' => 112.50,
      'roof_angle' => 40.0,
      'building_height' => 8.40,
      'min_lot_width' => 19.80,
      'min_lot_length' => 22.00,
      'rooms_count' => 5,
      'bathrooms_count' => 2,
      'garage' => '2-stanowiskowy',
      'heating_type' => 'Pompa ciepła gruntowa / możliwość kotła gazowego',
      'price_digital' => 3600.00,
      'price_print' => 4200.00,
      'is_hidden' => 0,
      'description' => 'Elegancki dom z poddaszem użytkowym idealny na węższe działki. Dwuspadowy dach z lukarnami zapewnia doskonałe doświetlenie piętra. Na parterze dodatkowy gabinet do pracy zdalnej.',
      'image_url' => '/modules/custom/architect_studio/images/debowa_polana.svg',
      'floor_plan_url' => '/modules/custom/architect_studio/images/plan_debowa_polana.svg',
      'created' => $time - 3600,
      'updated' => $time - 3600,
    ],
    [
      'code' => 'WIL-185',
      'title' => 'Willa Miejska Rezydencja 185',
      'category' => 'dom_pietrowy',
      'usable_area' => 185.20,
      'building_area' => 134.80,
      'roof_angle' => 22.0,
      'building_height' => 8.90,
      'min_lot_width' => 23.00,
      'min_lot_length' => 25.50,
      'rooms_count' => 6,
      'bathrooms_count' => 3,
      'garage' => '2-stanowiskowy w bryle',
      'heating_type' => 'Pompa ciepła + rekuperacja z odzyskiem wilgoci + instalacja PV',
      'price_digital' => 4200.00,
      'price_print' => 4900.00,
      'is_hidden' => 0,
      'description' => 'Pełne piętro bez skosów. Przestronna strefa master bedroom z prywatną garderobą i łazienką. Taras widokowy na piętrze oraz reprezentacyjna strefa wejściowa.',
      'image_url' => '/modules/custom/architect_studio/images/willa_miejska.svg',
      'floor_plan_url' => '/modules/custom/architect_studio/images/plan_willa_miejska.svg',
      'created' => $time - 7200,
      'updated' => $time - 7200,
    ],
    [
      'code' => 'GOS-54',
      'title' => 'Budynek Gospodarczy z Garażem G-54',
      'category' => 'gospodarczy_garaz',
      'usable_area' => 54.30,
      'building_area' => 64.00,
      'roof_angle' => 30.0,
      'building_height' => 5.60,
      'min_lot_width' => 16.00,
      'min_lot_length' => 18.00,
      'rooms_count' => 2,
      'bathrooms_count' => 1,
      'garage' => 'Garaż + warsztat',
      'heating_type' => 'Klimatyzator z funkcją grzania / promienniki',
      'price_digital' => 1900.00,
      'price_print' => 2300.00,
      'is_hidden' => 0,
      'description' => 'Funkcjonalny budynek gospodarczy z wydzielonym stanowiskiem garażowym, warsztatem oraz poddaszem nieużytkowym jako schowek sezonowy. Doskonały do uzupełnienia zagospodarowania działki.',
      'image_url' => '/modules/custom/architect_studio/images/garaz_g54.svg',
      'floor_plan_url' => '/modules/custom/architect_studio/images/plan_garaz_g54.svg',
      'created' => $time - 10800,
      'updated' => $time - 10800,
    ],
  ];

  foreach ($projects as $project) {
    $database->insert('architect_projects')
      ->fields($project)
      ->execute();
  }

  // Wyłączenie domyślnego linku 'Home' na rzecz dedykowanego 'Pracownia Architektoniczna'.
  /** @var \Drupal\Core\Menu\MenuLinkManagerInterface $menu_link_manager */
  $menu_link_manager = \Drupal::service('plugin.manager.menu.link');
  if ($menu_link_manager->hasDefinition('standard.front_page')) {
    $menu_link_manager->updateDefinition('standard.front_page', ['enabled' => 0]);
  }
}
