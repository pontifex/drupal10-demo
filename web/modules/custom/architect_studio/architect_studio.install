  $schema['architect_inquiries'] = [
    'description' => 'Tabela zapytań o adaptację projektów i modyfikacje.',
    'fields' => [
      'id' => [
        'description' => 'Identyfikator zapytania.',
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'customer_name' => [
        'description' => 'Imię i nazwisko inwestora.',
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'default' => '',
      ],
      'customer_email' => [
        'description' => 'E-mail inwestora.',
        'type' => 'varchar',
        'length' => 255,
