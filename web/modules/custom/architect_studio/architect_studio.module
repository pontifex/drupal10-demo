<?php

declare(strict_types=1);

use Drupal\Core\Asset\AttachedAssetsInterface;

/**
 * @file
 * Primary module hooks for architect_studio module.
 */

/**
 * Implements hook_theme().
 *
 * @return array<string, mixed>
 */
function architect_studio_theme(): array {
  return [
    'architect_showcase' => [
      'variables' => [
        'featured_projects' => [],
        'inquiry_form' => [],
      ],
      'template' => 'architect-showcase',
    ],
    'architect_catalog' => [
      'variables' => [
        'projects' => [],
        'filters' => [],
        'total_count' => 0,
        'pagination' => [],
      ],
      'template' => 'architect-catalog',
    ],
    'architect_project_detail' => [
      'variables' => [
        'project' => [],
      ],
      'template' => 'architect-project-detail',
    ],
    'architect_order_success' => [
      'variables' => [
        'order' => [],
        'project' => [],
        'is_masked' => FALSE,
      ],
      'template' => 'architect-order-success',
    ],
    'architect_terms' => [
      'variables' => [],
      'template' => 'architect-terms',
    ],
    'architect_privacy' => [
      'variables' => [],
      'template' => 'architect-privacy',
    ],
    'architect_footer' => [
      'variables' => [],
      'template' => 'architect-footer',
    ],
  ];
}

/**
 * Implements hook_preprocess_page().
 *
 * @param array<string, mixed> $variables
 *   Preprocess variables.
 */
function architect_studio_preprocess_page(array &$variables): void {
  // Dołącz profesjonalną stopkę pracowni w stylu Extradom do regionu stopki.
  if (isset($variables['page']['footer_bottom'])) {
    $variables['page']['footer_bottom']['architect_footer'] = [
      '#theme' => 'architect_footer',
      '#weight' => -100,
    ];
  }
}


/**
 * Implements hook_page_attachments().
 *
 * @param array<string, mixed> $attachments
 *   Page attachments array.
 */
function architect_studio_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'architect_studio/studio-styles';

  /** @var \Drupal\architect_studio\Service\SeoMetaService $seoService */
  $seoService = \Drupal::service('architect_studio.seo_meta');
  $routeMatch = \Drupal::routeMatch();
  $routeName = $routeMatch->getRouteName() ?? '';
  $parameters = $routeMatch->getRawParameters()->all();

  $seoService->attachSeoTags($attachments, $routeName, $parameters);
}

/**
 * Implements hook_css_alter().
 *
 * @param array<string, mixed> $css
 *   Array of CSS assets.
 * @param \Drupal\Core\Asset\AttachedAssetsInterface $assets
 *   Attached assets.
 */
function architect_studio_css_alter(array &$css, AttachedAssetsInterface $assets): void {
  $target = 'modules/custom/architect_studio/css/architect-studio.css';
  if (isset($css[$target])) {
    $css[$target]['group'] = CSS_THEME;
    $css[$target]['weight'] = 9999;
  }
}

/**
 * Implements hook_toolbar_alter().
 *
 * @param array<string, mixed> $items
 *   Toolbar items.
 */
function architect_studio_toolbar_alter(array &$items): void {
  // Usuń ostrzeżenie profilu demonstracyjnego w pasku administracyjnym.
  unset($items['experimental-profile-warning']);
}
