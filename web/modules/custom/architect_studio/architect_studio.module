<?php

declare(strict_types=1);

use Drupal\Core\Asset\AttachedAssetsInterface;

/**
 * @file
 * Primary module hooks for architect_studio module.
 */

/**
 * Implements hook_theme().
 *
 * @return array<string, mixed>
 */
function architect_studio_theme(): array {
  return [
    'architect_showcase' => [
      'variables' => [
        'featured_projects' => [],
        'inquiry_form' => [],
      ],
      'template' => 'architect-showcase',
    ],
    'architect_catalog' => [
      'variables' => [
        'projects' => [],
        'filters' => [],
        'total_count' => 0,
        'pagination' => [],
      ],
      'template' => 'architect-catalog',
    ],
    'architect_project_detail' => [
      'variables' => [
        'project' => [],
      ],
      'template' => 'architect-project-detail',
    ],
    'architect_order_success' => [
      'variables' => [
        'order' => [],
        'project' => [],
        'is_masked' => FALSE,
      ],
      'template' => 'architect-order-success',
    ],
    'architect_terms' => [
      'variables' => [],
      'template' => 'architect-terms',
    ],
    'architect_privacy' => [
      'variables' => [],
      'template' => 'architect-privacy',
    ],
    'architect_footer' => [
      'variables' => [],
      'template' => 'architect-footer',
    ],
    'architect_404' => [
      'variables' => [],
      'template' => 'architect-404',
    ],
    'architect_mobile_call_button' => [
      'variables' => [
        'phone_number' => '+48 500 123 456',
        'phone_raw' => '+48500123456',
      ],
      'template' => 'architect-mobile-call-button',
    ],
  ];
}

/**
 * Implements hook_preprocess_page().
 *
 * @param array<string, mixed> $variables
 *   Preprocess variables.
 */
function architect_studio_preprocess_page(array &$variables): void {
  // Dołącz profesjonalną stopkę pracowni w stylu Extradom do regionu stopki.
  if (isset($variables['page']['footer_bottom'])) {
    $variables['page']['footer_bottom']['architect_footer'] = [
      '#theme' => 'architect_footer',
      '#weight' => -100,
    ];
  }

  // Dołącz pływający przycisk kontaktu na smartfonach.
  if (isset($variables['page']['footer_bottom'])) {
    $variables['page']['footer_bottom']['architect_mobile_call_button'] = [
      '#theme' => 'architect_mobile_call_button',
      '#weight' => 999,
    ];
  }
}


/**
 * Implements hook_page_attachments().
 *
 * @param array<string, mixed> $attachments
 *   Page attachments array.
 */
function architect_studio_page_attachments(array &$attachments): void {
  $attachments['#attached']['library'][] = 'architect_studio/studio-styles';

  /** @var \Drupal\architect_studio\Service\SeoMetaService $seoService */
  $seoService = \Drupal::service('architect_studio.seo_meta');
  $routeMatch = \Drupal::routeMatch();
  $routeName = $routeMatch->getRouteName() ?? '';
  $parameters = $routeMatch->getRawParameters()->all();

  $seoService->attachSeoTags($attachments, $routeName, $parameters);
}

/**
 * Implements hook_css_alter().
 *
 * @param array<string, mixed> $css
 *   Array of CSS assets.
 * @param \Drupal\Core\Asset\AttachedAssetsInterface $assets
 *   Attached assets.
 */
function architect_studio_css_alter(array &$css, AttachedAssetsInterface $assets): void {
  $target = 'modules/custom/architect_studio/css/architect-studio.css';
  if (isset($css[$target])) {
    $css[$target]['group'] = CSS_THEME;
    $css[$target]['weight'] = 9999;
  }
}

/**
 * Implements hook_toolbar_alter().
 *
 * @param array<string, mixed> $items
 *   Toolbar items.
 */
function architect_studio_toolbar_alter(array &$items): void {
  // Usuń ostrzeżenie profilu demonstracyjnego w pasku administracyjnym.
  unset($items['experimental-profile-warning']);
}

/**
 * Implements hook_mail().
 *
 * @param string $key
 *   Klucz wiadomości.
 * @param array<string, mixed> $message
 *   Tablica wiadomości e-mail.
 * @param array<string, mixed> $params
 *   Parametry przekazane do maila.
 */
function architect_studio_mail(string $key, array &$message, array $params): void {
  switch ($key) {
    case 'inquiry_notify_architect':
      $inquiry = $params['inquiry'] ?? [];
      $message['subject'] = '🔔 [Nowe Zapytanie] Wycena adaptacji: ' . ($inquiry['customer_name'] ?? '');
      $body = [];
      $body[] = 'Otrzymano nowe zapytanie o adaptację projektu / wycenę ze strony internetowej:';
      $body[] = '--------------------------------------------------';
      $body[] = 'Inwestor: ' . ($inquiry['customer_name'] ?? '');
      $body[] = 'E-mail: ' . ($inquiry['customer_email'] ?? '');
      $body[] = 'Telefon: ' . ($inquiry['customer_phone'] ?? '');
      $body[] = 'Rodzaj usługi: ' . ($inquiry['inquiry_type'] ?? '');
      $body[] = 'Lokalizacja / Działka: ' . ($inquiry['plot_location'] ?? 'Brak podanej');
      $body[] = 'Link do projektu gotowego: ' . ($inquiry['project_link'] ?? 'Brak');
      $body[] = '--------------------------------------------------';
      $body[] = 'Wiadomość / Zakres modyfikacji:';
      $body[] = (string) ($inquiry['message'] ?? '');
      $body[] = '--------------------------------------------------';
      $body[] = 'Panel administracyjny: /admin/architect/inquiries';
      $message['body'] = $body;
      break;

    case 'inquiry_confirm_customer':
      $inquiry = $params['inquiry'] ?? [];
      $message['subject'] = 'Potwierdzenie przyjęcia zapytania – Pracownia Architektoniczna Kraśnik & Annopol';
      $body = [];
      $body[] = 'Dzień dobry ' . ($inquiry['customer_name'] ?? '') . ',';
      $body[] = '';
      $body[] = 'Dziękujemy za kontakt z naszą Pracownią Architektoniczną. Twoje zapytanie dotyczące wyceny adaptacji zostało pomyślnie zarejestrowane.';
      $body[] = 'Architekt zapozna się z uwarunkowaniami Twojej działki i skontaktuje się z Tobą w ciągu 24-48 godzin.';
      $body[] = '';
      $body[] = 'Podsumowanie zgłoszenia:';
      $body[] = '- Usługa: ' . ($inquiry['inquiry_type'] ?? '');
      $body[] = '- Działka: ' . ($inquiry['plot_location'] ?? 'Do uzgodnienia');
      $body[] = '';
      $body[] = 'Z poważaniem,';
      $body[] = 'Pracownia Architektoniczna Kraśnik & Annopol';
      $body[] = 'ul. Lubelska 14, 23-200 Kraśnik | tel. +48 500 123 456';
      $message['body'] = $body;
      break;

    case 'order_notify_architect':
      $order = $params['order'] ?? [];
      $message['subject'] = '💳 [Nowe Zamówienie BLIK] ' . ($order['order_number'] ?? '') . ' – ' . ($order['project_title'] ?? '');
      $body = [];
      $body[] = 'Złożono i opłacono nowe zamówienie na projekt w serwisie:';
      $body[] = '--------------------------------------------------';
      $body[] = 'Numer zamówienia: ' . ($order['order_number'] ?? '');
      $body[] = 'Projekt: ' . ($order['project_title'] ?? '');
      $body[] = 'Wariant: ' . (($order['variant'] ?? '') === 'print' ? 'Drukowany (4 egzemplarze do urzędu)' : 'Cyfrowy (PDF)');
      $body[] = 'Kwota: ' . number_format((float) ($order['amount'] ?? 0), 2, ',', ' ') . ' PLN (Opłacone BLIK)';
      $body[] = 'Zamawiający: ' . ($order['customer_name'] ?? '');
      $body[] = 'E-mail: ' . ($order['customer_email'] ?? '');
      $body[] = 'Telefon: ' . ($order['customer_phone'] ?? '');
      if (!empty($order['shipping_address'])) {
        $body[] = 'Adres dostawy kurierskiej: ' . $order['shipping_address'];
      }
      if (!empty($order['invoice_nip'])) {
        $body[] = 'Dane do faktury (NIP): ' . $order['invoice_nip'];
      }
      $body[] = '--------------------------------------------------';
      $body[] = 'Panel administracyjny: /admin/architect/orders';
      $message['body'] = $body;
      break;

    case 'order_confirm_customer':
      $order = $params['order'] ?? [];
      $message['subject'] = 'Potwierdzenie opłacenia zamówienia ' . ($order['order_number'] ?? '') . ' – Pracownia Architektoniczna';
      $body = [];
      $body[] = 'Dzień dobry ' . ($order['customer_name'] ?? '') . ',';
      $body[] = '';
      $body[] = 'Dziękujemy za zakup projektu architektonicznego w naszej pracowni!';
      $body[] = 'Twoja płatność BLIK została zaksięgowana pomyślnie.';
      $body[] = '';
      $body[] = 'Szczegóły zamówienia:';
      $body[] = '- Numer: ' . ($order['order_number'] ?? '');
      $body[] = '- Projekt: ' . ($order['project_title'] ?? '');
      $body[] = '- Wariant: ' . (($order['variant'] ?? '') === 'print' ? 'Wersja drukowana (4 egz. do urzędu z pieczęciami)' : 'Wersja cyfrowa (PDF)');
      $body[] = '- Opłacona kwota: ' . number_format((float) ($order['amount'] ?? 0), 2, ',', ' ') . ' PLN';
      $body[] = '';
      if (($order['variant'] ?? '') === 'print') {
        $body[] = 'Komplet dokumentacji zostanie wysłany przesyłką kurierską w ciągu 24-48h na podany adres.';
      }
      else {
        $body[] = 'Pliki dokumentacji oraz zgoda autora na zmiany zostały dołączone do niniejszej korespondencji.';
      }
      $body[] = '';
      $body[] = 'Z poważaniem,';
      $body[] = 'Pracownia Architektoniczna Kraśnik & Annopol';
      $body[] = 'ul. Lubelska 14, 23-200 Kraśnik | tel. +48 500 123 456';
      $message['body'] = $body;
      break;
  }
}

