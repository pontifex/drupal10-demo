{#
/**
 * @file
 * Szablon Twig dla widoku symfony_demo_page.
 *
 * Drupal używa w 100% silnika Twig! Poniżej standardowe konstrukcje Twig.
 */
#}
<div class="symfony-drupal-demo-container" style="font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 1000px; margin: 2rem auto; padding: 2rem; background: #ffffff; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); border: 1px solid #e2e8f0; color: #1e293b;">

  <div style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%); color: white; padding: 2rem; border-radius: 10px; margin-bottom: 2rem;">
    <h1 style="margin: 0 0 0.5rem 0; font-size: 2rem; color: #ffffff;">Drupal 10 dla Programisty Symfony 🚀</h1>
    <p style="margin: 0; font-size: 1.1rem; opacity: 0.95;">
      {{ greeting }}
    </p>
  </div>

  <section style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.4rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem; color: #0f172a;">
      1. Jak Drupal 10 mapuje się na Symfony?
    </h2>
    <table style="width: 100%; border-collapse: collapse; margin-top: 1rem; font-size: 0.95rem;">
      <thead>
        <tr style="background: #f8fafc; text-align: left;">
          <th style="padding: 10px; border: 1px solid #e2e8f0;">Koncepcja Symfony</th>
          <th style="padding: 10px; border: 1px solid #e2e8f0;">Odpowiednik w Drupalu 10</th>
          <th style="padding: 10px; border: 1px solid #e2e8f0;">Uwagi</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><code>Bundle</code></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><strong>Module</strong> (katalog <code>web/modules/custom/*</code>)</td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;">Opisany przez <code>nazwa.info.yml</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><code>config/routes.yaml</code></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><strong><code>nazwa.routing.yml</code></strong></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;">Ten sam komponent <code>symfony/routing</code>!</td>
        </tr>
        <tr>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><code>config/services.yaml</code></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><strong><code>nazwa.services.yml</code></strong></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;">Kontener Symfony DI, tagi (np. <code>event_subscriber</code>)</td>
        </tr>
        <tr>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><code>EventDispatcher</code></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><strong><code>EventDispatcherInterface</code></strong></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;">Standardowe <code>EventSubscriberInterface</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><code>Doctrine ORM (Entities)</code></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><strong>Drupal Entity API</strong> (<code>Node</code>, <code>Taxonomy</code>, <code>User</code>)</td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;">Wbudowany CRUD, pola w UI i kodzie, Entity Queries</td>
        </tr>
        <tr>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><code>bin/console</code></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><strong><code>./drush</code></strong></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><code>./drush cr</code>, <code>./drush uli</code>, <code>./drush cex</code></td>
        </tr>
        <tr>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><code>Twig</code></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;"><strong>Twig 3</strong></td>
          <td style="padding: 10px; border: 1px solid #e2e8f0;">Szablony w <code>templates/*.html.twig</code></td>
        </tr>
      </tbody>
    </table>
  </section>

  <section style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.4rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem; color: #0f172a;">
      2. Dane z bazy pobrane przez Entity Query (Umami Recipes)
    </h2>
    <p style="color: #64748b; font-size: 0.95rem;">
      Poniższe przepisy zostały pobrane przez nasz serwis <code>DemoService::getLatestRecipes()</code> korzystający z <code>EntityTypeManager</code>:
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1rem; margin-top: 1rem;">
      {% for recipe in recipes %}
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1rem;">
          <h3 style="margin-top: 0; font-size: 1.1rem; color: #0369a1;">
            <a href="{{ recipe.url }}" style="text-decoration: none; color: inherit;">{{ recipe.title }}</a>
          </h3>
          <p style="margin: 0.25rem 0; font-size: 0.85rem; color: #64748b;">
            Poziom: <strong>{{ recipe.difficulty }}</strong> | Przygotowanie: <strong>{{ recipe.prep_time }} min</strong>
          </p>
          <a href="{{ recipe.url }}" style="display: inline-block; margin-top: 0.5rem; font-size: 0.85rem; color: #0284c7; text-decoration: underline;">
            Zobacz przepis w Drupalu &rarr;
          </a>
        </div>
      {% else %}
        <p>Brak przepisów w bazie.</p>
      {% endfor %}
    </div>
  </section>

  <section style="margin-bottom: 2rem;">
    <h2 style="font-size: 1.4rem; border-bottom: 2px solid #e2e8f0; padding-bottom: 0.5rem; color: #0f172a;">
      3. Przetestuj endpointy modułu
    </h2>
    <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
      <a href="/demo/symfony" style="background: #0284c7; color: white; padding: 0.75rem 1.25rem; border-radius: 6px; text-decoration: none; font-weight: 500;">
        Ten widok HTML (/demo/symfony)
      </a>
      <a href="/api/v1/demo-recipes" target="_blank" style="background: #0f172a; color: white; padding: 0.75rem 1.25rem; border-radius: 6px; text-decoration: none; font-weight: 500;">
        Symfony JsonResponse (/api/v1/demo-recipes) &rarr;
      </a>
      <a href="/admin" target="_blank" style="background: #10b981; color: white; padding: 0.75rem 1.25rem; border-radius: 6px; text-decoration: none; font-weight: 500;">
        Panel administracyjny (/admin) &rarr;
      </a>
    </div>
  </section>

  <footer style="border-top: 1px solid #e2e8f0; padding-top: 1rem; font-size: 0.85rem; color: #94a3b8; text-align: center;">
    Zainstalowano: Drupal 10.6.18 • Profil demo: Umami • Silnik: PHP 8.4 + Apache + MariaDB
  </footer>

</div>
